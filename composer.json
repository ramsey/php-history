{
    "name": "phpc/history",
    "description": "Collecting, preserving, and sharing the stories of the PHP programming language and its community.",
    "license": "(AGPL-3.0-or-later and CC0-1.0)",
    "type": "project",
    "keywords": [
        "history"
    ],
    "require": {
        "php": "~8.4.0",
        "laravel-zero/framework": "^11.36"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.45",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "phphist"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
